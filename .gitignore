# Виртуальное окружение — должно пересоздаваться из requirements.txt
venv/
.venv/
env/
.env/
my_env/
.my_env/
ENV/

# Файлы Python-кэша (можно безопасно игнорировать)
__pycache__/
*.py[cod]
*$py.class

# Файлы Django и базы данных
*.log
db.sqlite3          # Локальная БД — не подходит для продакшена
db.sqlite3-journal
/media/             # Пользовательские файлы (очень важная строка!)
/staticfiles/       # Собранная статика (если используется)

# Секреты и настройки окружения — их нельзя коммитить никогда!
.env
.env.local
secrets.json
local_settings.py   # Этот файл часто используют для переопределения настроек
enviroment_var

# Файлы IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Файлы тестов и покрытия
.coverage
htmlcov/
.tox/

# Файлы дистрибуции
dist/
build/
*.egg-info/
*.egg
db.sqlite3
